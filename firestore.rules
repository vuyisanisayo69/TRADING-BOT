rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'activeEnvironment',
          'emergencyTradingDisabled',
          'liveTradingEnabled'
        ])
        && data.uid is string
        && data.uid == userId
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 254
        && data.activeEnvironment in ['SIMULATION', 'MT5_DEMO']
        && data.emergencyTradingDisabled is bool
        && data.liveTradingEnabled == false
        && (!('role' in data) || data.role == 'trader')
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120));
    }

    function isValidTradingPreferences(data) {
      return data.keys().hasAll([
          'symbols',
          'defaultSymbol',
          'defaultTimeframe',
          'botMode',
          'sizingMode',
          'fixedPositionSize'
        ])
        && data.symbols is list
        && data.symbols.size() >= 1
        && data.symbols.size() <= 25
        && data.defaultSymbol is string
        && data.defaultSymbol.size() >= 3
        && data.defaultSymbol.size() <= 20
        && data.defaultTimeframe in ['M1', 'M5', 'M15', 'H1', 'H4']
        && data.botMode in ['CLASSIC', 'BRAIN']
        && data.sizingMode in ['RISK_PERCENT', 'FIXED_LOT']
        && data.fixedPositionSize is number
        && data.fixedPositionSize >= 0.01
        && data.fixedPositionSize <= 100
        && (!('riskPercentagePerTrade' in data) || (data.riskPercentagePerTrade is number && data.riskPercentagePerTrade >= 0.05 && data.riskPercentagePerTrade <= 10))
        && (!('emergencyTradingDisabled' in data) || data.emergencyTradingDisabled is bool);
    }

    function isValidEnvironmentWorkspace(data, envId) {
      return envId in ['SIMULATION', 'MT5_DEMO']
        && data.keys().hasAll(['environment', 'accountState', 'riskConfig', 'botSettings'])
        && data.environment == envId
        && data.accountState is map
        && data.riskConfig is map
        && data.botSettings is map
        && (!('brokerPassword' in data))
        && (!('liveTradingEnabled' in data) || data.liveTradingEnabled == false);
    }

    function isValidAlertDoc(data) {
      return data.keys().hasAll(['id', 'symbol', 'targetPrice', 'condition', 'status'])
        && data.id is string
        && data.id.size() <= 80
        && data.symbol is string
        && data.symbol.size() <= 20
        && data.targetPrice is number
        && data.condition in ['CROSSES_ABOVE', 'CROSSES_BELOW']
        && data.status in ['ACTIVE', 'TRIGGERED', 'DISABLED'];
    }

    function isValidJournalDoc(data) {
      return data.keys().hasAll(['id', 'environment', 'symbol', 'side', 'lots'])
        && data.id is string
        && data.id.size() <= 80
        && data.environment in ['SIMULATION', 'MT5_DEMO']
        && data.symbol is string
        && data.symbol.size() <= 24
        && data.side in ['LONG', 'SHORT']
        && data.lots is number
        && data.lots > 0
        && (!('ticketId' in data) || (data.ticketId is string && data.ticketId.size() <= 40))
        && (!('processGrade' in data) || data.processGrade in ['FOLLOWED_PLAN', 'MINOR_DEVIATION', 'PROCESS_BREACH', 'UNPLANNED'])
        && (!('outcomeGrade' in data) || data.outcomeGrade in ['WIN', 'LOSS', 'BREAKEVEN'])
        && (!('processNotes' in data) || (data.processNotes is string && data.processNotes.size() <= 600));
    }

    function isValidTradeTicket(data) {
      return data.keys().hasAll([
          'id',
          'environment',
          'symbol',
          'side',
          'entryPrice',
          'stopLoss',
          'takeProfit',
          'status',
          'liveTradingEnabled',
          'createdAtMs',
          'expiresAtMs'
        ])
        && data.id is string
        && data.id.size() >= 6
        && data.id.size() <= 40
        && data.environment in ['SIMULATION', 'MT5_DEMO']
        && data.symbol is string
        && data.symbol.size() >= 2
        && data.symbol.size() <= 24
        && data.side in ['LONG', 'SHORT']
        && data.entryPrice is number && data.entryPrice > 0
        && data.stopLoss is number && data.stopLoss > 0
        && data.takeProfit is number && data.takeProfit > 0
        && data.createdAtMs is number && data.createdAtMs > 0
        && data.expiresAtMs is number && data.expiresAtMs >= data.createdAtMs
        && data.status in ['PROPOSED', 'RISK_PASS', 'RISK_REJECT', 'APPROVED', 'EXECUTED', 'EXPIRED', 'CANCELLED']
        && data.liveTradingEnabled == false
        && (!('thesis' in data) || (data.thesis is string && data.thesis.size() <= 1000))
        && (!('invalidation' in data) || (data.invalidation is string && data.invalidation.size() <= 500))
        && (!('evidence' in data) || (data.evidence is list && data.evidence.size() <= 12));
    }

    // Authenticated connection probe document (read-only)
    match /test/connection {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // User-scoped trading data
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId)
        && isValidUserProfile(request.resource.data, userId)
        && request.resource.data.uid == resource.data.uid
        && (!('role' in resource.data) || request.resource.data.role == resource.data.role);
      allow delete: if false;

      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTradingPreferences(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /environments/{envId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidEnvironmentWorkspace(request.resource.data, envId);
        allow delete: if isOwner(userId);
      }

      match /alerts/{alertId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidAlertDoc(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /journal/{entryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidJournalDoc(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /tickets/{ticketId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(ticketId);
        allow create: if isOwner(userId) && isValidId(ticketId) && isValidTradeTicket(request.resource.data);
        allow update: if isOwner(userId)
          && isValidId(ticketId)
          && isValidTradeTicket(request.resource.data)
          && resource.data.status in ['PROPOSED', 'RISK_PASS', 'RISK_REJECT', 'APPROVED']
          && request.resource.data.id == resource.data.id
          && request.resource.data.environment == resource.data.environment
          && request.resource.data.createdAtMs == resource.data.createdAtMs;
        allow delete: if isOwner(userId) && isValidId(ticketId);
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
